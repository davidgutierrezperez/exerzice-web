{% block styles %}
    <link rel='stylesheet' href='/css/components/community/community-summary.css'>
{% endblock %}

<div class='community-summary flex-row align-items'>
    <img class='small-image-logo' src='/images/examples/other-trail-running-image.jpg'>

    <div class='flex-column community-summary-info justify-evently'>
        <h2 class='title-media-content'>{{ community.name }}</h2>

        <div class='community-summary-members-info tiny-gap flex-row text-secundary align-items'>
            <p>{{ community.followers }} members</p>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dot-icon lucide-dot"><circle cx="12" cy="12" r="1"/></svg>
            <p>{{ community.sport.name }}</p>
        </div>
    </div>
</div>