<header class='layout align-items'>
    
    <a href='/'>
        <img class='company-logo' src='/images/logos/exerzice-logo.svg'>
    </a>

    {% include 'components/navigation/header-nav.twig' %}

    <div class='flex-row align-horizontaly justify-between medium-gap'>
        {% if isLoggedIn %}
            {% include 'components/user/small-user-info.twig' 
                with {
                    user: {
                        name: userName,
                        id: userId,
                        picture: avatarUrl,
                        verified: userVerified
                    }
                }
            %}
        {% else %}
            <a href='/login' class='big-button no-background-button'>Sign in</a>
            <a href='/register' class='big-button background-button'>Register</a>
        {% endif %}
    </div>
</header>