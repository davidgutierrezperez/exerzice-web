{% block styles %}
	<link rel='stylesheet' href='/css/components/posts/post.css'>
{% endblock %}

{% block scripts %}
	<script type='module' src='/js/components/post/PostIndex.js'></script>
{% endblock %}

<article
	class='post flex-column' data-component='post-summary' data-component-id='{{ post.id }}'>

	<!-- HEADER OF THE POST -->
	<div class='post-header flex-row justify-evently align-items'>

		{% include 'components/user/small-user-info.twig' 
            with {
                user: {
                    name: post.created_by.name,
                    id: post.created_by.id,
                    verified: post.created_by.verified,
                    picture: post.created_by.avatar_url
                }
            } %}

		<!-- CREATION DATE OF THE POST -->
		<p class='text-secondary'>{{ post.created_at}}</p>

		<!-- THREE DOT ICON -->
		<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ellipsis-icon lucide-ellipsis"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
	</div>

	<!-- CONTENT OF THE POST -->
	<p>{{ post.content }}</p>

	<!-- INTERACTION WITH THE POST -->
	<div
		class='post-interaction flex-row'>

		<!-- FORM TO LIKE THE POST -->
		<form class='align-items' data-component='like-form' data-value='{{ post.liked_by_user }}'>
			<button type='submit'>
				<svg data-action='like-button' 
					xmlns="http://www.w3.org/2000/svg" 
					
					{% if post.liked_by_user %}
						fill='#6C35F2'
						stroke-color='#6C35F2 !important'
					{% else %}
						fill='none'
					{% endif %}

					width="24" height="24" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-flame-icon lucide-flame"><path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4"/></svg>
			</button>
			<p data-role='like-counter'>{{ post.likes }}</p>
		</form>

		<!-- FORM TO COMMENT IN THE POST -->
		<form class='align-items'>
			<button type='submit'>
				<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle-icon lucide-message-circle"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></svg>
			</button>
			<p>
				{% if post.comments_counter %}
					{{ post.comments_counter }}
				{% else %}
					0
				{% endif %}
			</p>
		</form>

		<a href='/post/{{ post.id }}'>
			<svg xmlns="http://www.w3.org/2000/svg"  viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zoom-in-icon lucide-zoom-in"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/><line x1="11" x2="11" y1="8" y2="14"/><line x1="8" x2="14" y1="11" y2="11"/></svg>
		</a>

	</div>

</article>
