{% block style %}
	<link rel='stylesheet' href='/css/components/posts/post.css'>
{% endblock %}

<div class='post flex-column'>

    <!-- HEADER OF THE POST -->
	<div class='post-header flex-row justify-evently align-items'>

        <!-- PICTURE OF THE USER -->
		<img src='/images/examples/other_user_photo.jpg' class='post-user-image'>

        <!-- INFORMATION ABOUT THE USER -->
		<div class='post-user-info flex-column'>

            <!-- NAME AND VERIFICATION STATUS-->
			<div class='post-user-name-info flex-row'>
				<h2 class='post-user-name text-primary'>
                    <a href='/user/{{ post.created_by.id }}' class='text-primary'>
                        {{ post.created_by.name }}
                    </a>
                </h2>

				{% if post.created_by.verified %}
					<svg class='user-verified-icon' xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-badge-check-icon lucide-badge-check"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/></svg>
				{% endif %}
			</div>

            <!-- SPORT OF THE POST -->
			<p class='text-secondary'>Sport</p>
		</div>

        <!-- CREATION DATE OF THE POST -->
		<p class='text-secondary'>{{ post.created_at}}</p>

        <!-- THREE DOT ICON -->
		<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ellipsis-icon lucide-ellipsis"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
	</div>

    <!-- CONTENT OF THE POST -->
	<p>{{ post.content }}</p>

    <!-- INTERACTION WITH THE POST -->
    <div class='post-interaction flex-row'>

        <!-- FORM TO LIKE THE POST -->
        <form class='align-items'>
            <button type='submit'>
                <svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart-icon lucide-heart"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/></svg>
            </button>
            <p>{{ post.likes }}</p>
        </form>

        <!-- FORM TO COMMENT IN THE POST -->
        <form class='align-items'>
            <button type='submit'>
                <svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle-icon lucide-message-circle"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"/></svg>
            </button>
            <p>{{ post.comments_counter }}</p>
        </form>
        
    </div>

</div>
