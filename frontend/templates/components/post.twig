{% block styles %}
<link rel="stylesheet" href="/css/components/posts.css">
{% endblock %}

<div class='post flex-column'>
    <div class='post-main-content flex-row'>
        <img class='user-picture' src='/images/examples/other_user_logo.png'>

        <div class='post-info flex-column'>
            <div calss='post-info-header flex-column'>
                <h2 class='user-name'>{{ post.created_by.name }}</h2>
                <p class='post-creation-date'>{{ post.created_at }}</p>
            </div>

            <p class='post-content'>{{ post.content }}</p>
        </div>
    </div>

    <div class='post-media'>
        <img class='post-image-media' src='/images/examples/trail-running.jpg'>
    </div>

    <div class='post-interaction'>
        <div class='icon-info flex-row'>
            <i class="fa-regular fa-heart"></i>
            <p>{{ post.likes }}</p>
        </div>
    </div>
</div>
