{% extends 'base-headered.twig' %}

{% block styles %}
	{{ parent() }}
	<link rel='stylesheet' href='/css/pages/auth.css'>
{% endblock %}

{% block scripts %}
	<script src="https://accounts.google.com/gsi/client" async defer></script>
{% endblock %}

{% block main_content %}
	<section class='section-login flex-column align-items big-gap justify-center'>

        <!-- LOGIN CONTENT DIV -->
		<div class='login-content flex-column align-items justify-center big-gap'>

            <!-- WELCOME TEXT -->
			<div class='login-welcome-text flex-column medium-gap'>

                <!-- WELCOME TITLE -->
				<h1>{{ title }}</h1>

                <!-- WELCOME PARAGRAPH -->
				<div class='login-paragraph tiny-gap flex-column align-items text-align'>
					<p class='text-secundary'>{{ first_paragraph }}.</p>
					<p class='text-secundary'>{{ second_paragraph }}.</p>
				</div>
			</div>

            <!-- GOOGLE API SIGNIN METHOD -->
			<div id="g_id_onload" 
				 data-client_id="299005082298-behm81dc27iofbhc1a2bdsr26h1bnfj5.apps.googleusercontent.com" 
				 data-ux_mode="redirect"
				 data-login_uri='/{{ handle }}'>
			</div>

			<div class="g_id_signin signin-method no-overflow" data-type="standard" data-theme="outline" data-size="large" data-text="{{ type }}_with" data-width="450"></div>

            <!-- TEXT UNDER SIGNIN METHOD -->
			<p class='text-secundary'>
                When {{ type }}, you accept the
				<a href='/service-terms' class='primary-link'>Terms of service</a>
				and
				<a class='primary-link' href='/privacy-politics'>Privacy politics</a>
			</p>
		</div>

        <!-- IMAGE -->
		<img src='/images/pages/login/axel-login.jpeg'>
	</section>
{% endblock %}
