{% extends 'base.twig' %}

{% block styles %}
    {{ parent() }}
    <link rel='stylesheet' href='/css/pages/index.css'>
{% endblock %}

{% block content %}
    <header>
        {% include 'components/search/search-bar.twig' %}
    </header>
    {% include 'components/navigation/aside-nav.twig' %}

    <section class='posts-section'>
        {% if posts %}
            {% for post in posts %}
                {% include 'components/posts/post.twig' with {post: post} %}
            {% endfor %}
        {% else %}
            <p class='error'>No posts were found</p>
        {% endif %}
    </section>

    <aside>
        {% include 'components/community/community-summary-list.twig' with { communities: spaces } %}
    </aside>
{% endblock %}