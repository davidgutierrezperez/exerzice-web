{% extends 'base-headered-aside.twig' %}

{% block styles %}
	{{ parent() }}
	<link rel='stylesheet' href='/css/pages/posts/create-post.css'>
{% endblock %}

{% block center_content %}
	<div class='create-post-page flex-column bigger-gap'>
		<form method='post' action='/post' class='bigger-gap flex-column'>
			<div class='flex-row justify-between align-items'>
				<div class='flex-column small-gap'>
					<h2>Create a post</h2>
					<p class='text-secondary'>Share something</p>
				</div>
				<button type='submit' class='default-button'>Create</button>
			</div>

			{% include 'components/user/small-user-info.twig' with {
            user: {
                name: userName,
                id: userId,
				picture: avatarUrl
            }
        } %}

			<textarea class='input-text big-input-text border-focusable bold medium-text' placeholder='Share something...' name='content' required></textarea>
		</form>

		<div class='flex-row bigger-gap align-items'>
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb-icon lucide-lightbulb"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>

			<p class='text-secondary small-text bold'>Warning: the post must only be sports related.</p>
		</div>
	</div>
{% endblock %}
