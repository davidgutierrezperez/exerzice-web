{% extends 'base.twig' %}

{% block styles %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/communities.css">
    <link rel="stylesheet" href="/css/events.css">
{% endblock %}

{% block left_aside %}
    {% include 'components/navbar/aside_nav.twig' %}
{% endblock %}

{% block main_content %}
<section class="posts-section flex-column">
    {% if posts %}
        {% for post in posts %}
            {% include 'components/post.twig' with { post: post } %}
        {% endfor %}
    {% else %}
        <p class='error'>No se han encontrado publicaciones</p>
    {% endif %}
</section>
{% endblock %}

{% block right_aside %}
<section class='main-communities right-aside-section'>
    <div class='main-communities-header section-title-link-header flex-row'>
        <h2 class='title-header'>Main communities</h2>
        <a href='/communities' class='button borderless link'>See all</a>
    </div>

    {% if spaces %}
        <ul class='section-list flex-column'>
            {% for space in spaces %}
                {% include 'components/spaces.twig' with {space: space} %}
            {% endfor %}
        </ul>
    {% else %}
        <p class='error'>No se han encontrado comunidades</p>
    {% endif %}
</section>

<section class='next-events right-aside-section'>
    <div class='next-events-header section-title-link-header flex-row'>
        <h2 class='title-header'>Next events</h2>
        <a href='/events' class='button borderless link'>See all</a>
    </div>

    <ul class='section-list flex-column'>
        <div class='event-simple-link-div flex-row'>
            <img src='/images/examples/other-trail-running-image.jpg' class='big-image-logo'>

            <div class='event-simple-link-info flex-column'>
                <h3 class='bold'>Titulo del evento</h3>
                <p>
                    <i class='fa-regular fa-calendar'></i>
                    Fecha del evento
                </p>
                <p class='thin'>
                    <i class='fa-regular fa-compass'></i>
                    Lugar del evento
                </p>

                <p>Deporte</p>
            </div>
        </div>

        <div class='event-simple-link-div flex-row'>
            <img src='/images/examples/other-trail-running-image.jpg' class='big-image-logo'>

            <div class='event-simple-link-info flex-column'>
                <h3 class='bold'>Titulo del evento</h3>
                <p>
                    <i class='fa-regular fa-calendar'></i>
                    Fecha del evento
                </p>
                <p class='thin'>
                    <i class='fa-regular fa-compass'></i>
                    Lugar del evento
                </p>

                <p>Deporte</p>
            </div>
        </div>

        <div class='event-simple-link-div flex-row'>
            <img src='/images/examples/other-trail-running-image.jpg' class='big-image-logo'>

            <div class='event-simple-link-info flex-column'>
                <h3 class='bold'>Titulo del evento</h3>
                <p>
                    <i class='fa-regular fa-calendar'></i>
                    Fecha del evento
                </p>
                <p class='thin'>
                    <i class='fa-regular fa-compass'></i>
                    Lugar del evento
                </p>

                <p>Deporte</p>
            </div>
        </div>
    </ul>
</section>
{% endblock %}