            <div class='community-basic-info flex-column'>
                <p class='bold'>Titulo de comunidad</p>
                <p class='thin subinfo'>Número de miembros</p>
            </div>

            <form class='form-join-community flex-row'>
                <button type='submit' class='button button-padding'>Unirse</button>
            </form>
        </div>

