{% extends 'common_base.twig' %}

{% block styles %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/posts.css">
    <link rel="stylesheet" href="/css/communities.css">
    <link rel="stylesheet" href="/css/events.css">
{% endblock %}

{% block main_content %}
<section class='posts-section flex-column'>
    {% for post in posts %}
        {% include 'components/post.twig' with post %}
    {% endfor %}
</section>
{% endblock %}

